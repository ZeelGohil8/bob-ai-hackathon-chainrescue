# Copy this file to .env and fill in your actual values
# NEVER commit the .env file — it is in .gitignore

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
WATSONX_API_KEY=your_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model to use for disruption analysis and fleet insights
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2

# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=3000
APP_ENV=development
# Leave empty to disable API key auth during local development
CHAINRESCUE_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your frontend origin in production, e.g. https://chainrescue.example.com
CORS_ORIGIN=*

# ── Database (if replacing in-memory mock store) ──────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/chainrescue

# ── Notifications (optional) ──────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
